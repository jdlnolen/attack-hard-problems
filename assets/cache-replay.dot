digraph Replay {
  graph [bgcolor="#f6f8fc", pad="0.23", nodesep="0.40", ranksep="0.46", fontname="Helvetica", fontsize=18, fontcolor="#152742", label="Two workspaces request report 17", labelloc=t, labeljust=l]
  node [shape=box, style="rounded,filled", fillcolor="#ffffff", color="#91a8c7", fontname="Helvetica", fontcolor="#152742", fontsize=14, margin="0.18,0.10"]
  edge [color="#406284", penwidth=1.5, fontname="Helvetica", fontsize=12, arrowsize=0.7]

  subgraph cluster_original {
    label="Cache keyed by report ID"
    fontname="Helvetica"
    fontsize=15
    fontcolor="#152742"
    color="#91a8c7"
    style=rounded
    a1 [label="Orchard requests report 17\nCache stores 17"]
    a2 [label="Harbor requests report 17\nCache hits 17"]
    a3 [label="Harbor receives Orchard summary", fillcolor="#fde9e6", color="#be7771"]
    a1 -> a2 -> a3
  }

  subgraph cluster_repair {
    label="Cache keyed by workspace and ID"
    fontname="Helvetica"
    fontsize=15
    fontcolor="#152742"
    color="#91a8c7"
    style=rounded
    b1 [label="Orchard requests report 17\nCache stores (orchard, 17)"]
    b2 [label="Harbor requests report 17\nCache misses (harbor, 17)"]
    b3 [label="Harbor receives Harbor summary", fillcolor="#e2f5ed", color="#6ba390"]
    b1 -> b2 -> b3
  }
}
